{
  "$schema": "http://json.schemastore.org/template",
  "author": "Dimitri Mamulashvili",
  "classifications": ["AI", "Agents", "Claude", "ASP.NET Core"],
  "identity": "DotnetAgentKit.Template",
  "name": "Agent kit for ASP.NET Core",
  "shortName": "agent-kit",
  "description": "Adds Claude Code config (CLAUDE.md, rules, skills, agents, settings with .NET and frontend plugins) for ASP.NET Core with SvelteKit, Blazor, or no frontend.",
  "tags": {
    "language": "C#",
    "type": "item"
  },
  "sourceName": "MyApp",
  "symbols": {
    "frontend": {
      "type": "parameter",
      "datatype": "choice",
      "defaultValue": "svelte",
      "description": "Frontend framework the agent config targets",
      "choices": [
        { "choice": "svelte", "description": "SvelteKit with Svelte 5" },
        { "choice": "blazor", "description": "Blazor Web App" },
        { "choice": "none", "description": "No frontend (API only)" }
      ]
    },
    "database": {
      "type": "parameter",
      "datatype": "choice",
      "defaultValue": "postgres",
      "description": "Database the agent config targets",
      "choices": [
        { "choice": "postgres", "description": "PostgreSQL" },
        { "choice": "sqlserver", "description": "SQL Server" },
        { "choice": "other", "description": "Another database, with no database-specific guidance" }
      ]
    },
    "isPostgres": {
      "type": "computed",
      "value": "(database == \"postgres\")"
    },
    "isSqlServer": {
      "type": "computed",
      "value": "(database == \"sqlserver\")"
    },
    "isSvelte": {
      "type": "computed",
      "value": "(frontend == \"svelte\")"
    },
    "isBlazor": {
      "type": "computed",
      "value": "(frontend == \"blazor\")"
    },
    "isNone": {
      "type": "computed",
      "value": "(frontend == \"none\")"
    }
  },
  "sources": [
    {
      "exclude": [
        ".template.config/**"
      ],
      "rename": {
        ".claude/settings.jsonc": ".claude/settings.json"
      },
      "modifiers": [
        {
          "condition": "(!isPostgres)",
          "exclude": [".claude/skills/postgresql/**"]
        }
      ]
    }
  ],
  "SpecialCustomOperations": {
    "**/*.jsonc": {
      "operations": [
        {
          "type": "conditional",
          "configuration": {
            "if": ["//#if"],
            "else": ["//#else"],
            "elseif": ["//#elseif"],
            "endif": ["//#endif"],
            "trim": "true",
            "wholeLine": "true"
          }
        }
      ]
    },
    "**/*.md": {
      "operations": [
        {
          "type": "conditional",
          "configuration": {
            "if": ["<!--#if"],
            "else": ["<!--#else"],
            "elseif": ["<!--#elseif"],
            "endif": ["<!--#endif"],
            "trim": "true",
            "wholeLine": "true"
          }
        }
      ]
    }
  }
}
