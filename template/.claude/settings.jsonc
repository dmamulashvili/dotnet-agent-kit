{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "extraKnownMarketplaces": {
//#if (isSvelte)
    "svelte": {
      "source": {
        "source": "github",
        "repo": "sveltejs/ai-tools"
      }
    },
//#endif
//#if (!isNone)
    "agent-browser": {
      "source": {
        "source": "github",
        "repo": "vercel-labs/agent-browser"
      }
    },
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    },
//#endif
//#if (aspire)
    "aspire-skills": {
      "source": {
        "source": "github",
        "repo": "microsoft/aspire-skills"
      }
    },
//#endif
    "dotnet-agent-skills": {
      "source": {
        "source": "github",
        "repo": "dotnet/skills"
      }
    },
    "docker": {
      "source": {
        "source": "github",
        "repo": "docker/skills"
      }
    }
  },
  "enabledPlugins": {
//#if (isSvelte)
    "svelte@svelte": true,
//#endif
//#if (isBlazor)
    "dotnet-blazor@dotnet-agent-skills": true,
//#endif
//#if (!isNone)
    "frontend-design@claude-plugins-official": true,
    "agent-browser@agent-browser": true,
//#endif
//#if (aspire)
    "aspire@aspire-skills": true,
//#endif
    "dotnet@dotnet-agent-skills": true,
    "dotnet-aspnetcore@dotnet-agent-skills": true,
    "dotnet-data@dotnet-agent-skills": true,
    "dotnet-test@dotnet-agent-skills": true,
    "dotnet-diag@dotnet-agent-skills": true,
    "dotnet-msbuild@dotnet-agent-skills": true,
    "dotnet-nuget@dotnet-agent-skills": true,
    "docker-skills@docker": true
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/protect-applied-migrations.sh\""
          }
        ]
      }
    ]
  },
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "allow": [
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git blame *)",
      "Bash(git fetch *)",
      "Bash(git branch)",
      "Bash(git branch --list *)",
      "Bash(git branch --show-current)",
      "PowerShell(git status *)",
      "PowerShell(git diff *)",
      "PowerShell(git log *)",
      "PowerShell(git show *)",
      "PowerShell(git blame *)",
      "PowerShell(git fetch *)",
      "PowerShell(git branch)",
      "PowerShell(git branch --list *)",
      "PowerShell(git branch --show-current)"
    ],
    "ask": [
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git merge *)",
      "Bash(git rebase *)",
      "Bash(git cherry-pick *)",
      "Bash(git tag *)",
      "Bash(git reset *)",
      "Bash(git checkout *)",
      "Bash(git switch *)",
      "Bash(git restore *)",
      "Bash(git stash *)",
      "Bash(git branch -d *)",
      "Bash(git branch -m *)",
      "Bash(git branch -M *)",
      "Bash(git branch --delete *)",
      "Bash(git branch --move *)",
      "Bash(dotnet ef migrations remove --force*)",
      "Bash(dotnet ef migrations remove * --force*)",
      "Bash(docker system prune*)",
      "Bash(docker volume rm *)",
      "Bash(docker volume prune*)",
      "Bash(docker compose down -v*)",
      "Bash(docker compose down * -v*)",
      "Bash(docker compose down --volumes*)",
      "Bash(docker compose down * --volumes*)",
      "Bash(az *)",
      "Bash(aws *)",
      "Bash(kubectl *)",
      "Bash(terraform *)",
      "Bash(helm *)",
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(gh pr merge*)",
      "Bash(gh release *)",
      "PowerShell(git add *)",
      "PowerShell(git commit *)",
      "PowerShell(git push *)",
      "PowerShell(git merge *)",
      "PowerShell(git rebase *)",
      "PowerShell(git cherry-pick *)",
      "PowerShell(git tag *)",
      "PowerShell(git reset *)",
      "PowerShell(git checkout *)",
      "PowerShell(git switch *)",
      "PowerShell(git restore *)",
      "PowerShell(git stash *)",
      "PowerShell(git branch -d *)",
      "PowerShell(git branch -m *)",
      "PowerShell(git branch -M *)",
      "PowerShell(git branch --delete *)",
      "PowerShell(git branch --move *)",
      "PowerShell(dotnet ef migrations remove --force*)",
      "PowerShell(dotnet ef migrations remove * --force*)",
      "PowerShell(docker system prune*)",
      "PowerShell(docker volume rm *)",
      "PowerShell(docker volume prune*)",
      "PowerShell(docker compose down -v*)",
      "PowerShell(docker compose down * -v*)",
      "PowerShell(docker compose down --volumes*)",
      "PowerShell(docker compose down * --volumes*)",
      "PowerShell(az *)",
      "PowerShell(aws *)",
      "PowerShell(kubectl *)",
      "PowerShell(terraform *)",
      "PowerShell(helm *)",
      "PowerShell(rm -rf *)",
      "PowerShell(rm -fr *)",
      "PowerShell(gh pr merge*)",
      "PowerShell(gh release *)",
      "PowerShell(Remove-Item *-Recurse*)",
      "Read(~/AppData/Roaming/NuGet/NuGet.Config)",
      "Read(~/.nuget/NuGet/NuGet.Config)"
    ],
    "deny": [
      "Bash(git reset --hard*)",
      "Bash(git reset * --hard*)",
      "Bash(git push --force*)",
      "Bash(git push * --force*)",
      "Bash(git push -f*)",
      "Bash(git push * -f*)",
      "Bash(git push * +*)",
      "Bash(git clean *)",
      "Bash(git checkout -- .)",
      "Bash(git checkout .)",
      "Bash(git restore .)",
      "Bash(git branch -D *)",
      "Bash(git branch * -D*)",
      "Bash(git stash drop*)",
      "Bash(git stash clear*)",
      "Bash(git filter-branch *)",
      "Bash(git filter-repo *)",
      "Bash(git reflog expire *)",
      "Bash(git commit --no-verify*)",
      "Bash(git commit * --no-verify*)",
      "Bash(git commit -n*)",
      "Bash(git commit * -n *)",
      "Bash(git commit * -n)",
      "Bash(git push --no-verify*)",
      "Bash(git push * --no-verify*)",
      "Bash(dotnet ef database drop*)",
      "Bash(dotnet ef database update 0)",
      "Bash(dotnet ef database update 0 *)",
      "Bash(dotnet nuget push*)",
      "Bash(dotnet nuget delete*)",
      "Bash(gh repo delete*)",
      "Bash(dotnet user-secrets list*)",
      "PowerShell(git reset --hard*)",
      "PowerShell(git reset * --hard*)",
      "PowerShell(git push --force*)",
      "PowerShell(git push * --force*)",
      "PowerShell(git push -f*)",
      "PowerShell(git push * -f*)",
      "PowerShell(git push * +*)",
      "PowerShell(git clean *)",
      "PowerShell(git checkout -- .)",
      "PowerShell(git checkout .)",
      "PowerShell(git restore .)",
      "PowerShell(git branch -D *)",
      "PowerShell(git branch * -D*)",
      "PowerShell(git stash drop*)",
      "PowerShell(git stash clear*)",
      "PowerShell(git filter-branch *)",
      "PowerShell(git filter-repo *)",
      "PowerShell(git reflog expire *)",
      "PowerShell(git commit --no-verify*)",
      "PowerShell(git commit * --no-verify*)",
      "PowerShell(git commit -n*)",
      "PowerShell(git commit * -n *)",
      "PowerShell(git commit * -n)",
      "PowerShell(git push --no-verify*)",
      "PowerShell(git push * --no-verify*)",
      "PowerShell(dotnet ef database drop*)",
      "PowerShell(dotnet ef database update 0)",
      "PowerShell(dotnet ef database update 0 *)",
      "PowerShell(dotnet nuget push*)",
      "PowerShell(dotnet nuget delete*)",
      "PowerShell(gh repo delete*)",
      "PowerShell(dotnet user-secrets list*)",
      "Read(~/AppData/Roaming/Microsoft/UserSecrets/**)",
      "Read(~/.microsoft/usersecrets/**)",
      "Read(~/AppData/Local/ASP.NET/DataProtection-Keys/**)",
      "Read(~/.aspnet/DataProtection-Keys/**)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.azure/**)",
      "Read(~/.kube/**)",
      "Read(~/.docker/config.json)",
      "Read(**/*.pfx)",
      "Read(**/*.p12)",
      "Read(**/*.key)",
      "Read(.env)",
      "Read(.env.*)",
      "Read(!.env.example)"
    ]
  }
}
