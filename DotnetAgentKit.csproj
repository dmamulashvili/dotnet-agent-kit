<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageType>Template</PackageType>
    <PackageId>DotnetAgentKit</PackageId>
    <PackageVersion>0.1.0</PackageVersion>
    <Title>.NET Agent Kit</Title>
    <Authors>Dimitri Mamulashvili</Authors>
    <Description>dotnet new template that adds AI coding agent config for ASP.NET Core with a frontend of choice.</Description>
    <PackageTags>dotnet-new;templates;ai;agents;claude;aspnetcore;svelte</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <TargetFramework>netstandard2.0</TargetFramework>
    <IncludeContentInPack>true</IncludeContentInPack>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <ContentTargetFolders>content</ContentTargetFolders>
    <EnableDefaultItems>false</EnableDefaultItems>
    <!-- NuGet drops dot-prefixed files (.claude/, .template.config/) without this. -->
    <NoDefaultExcludes>true</NoDefaultExcludes>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="template\**\*" Exclude="template\**\bin\**;template\**\obj\**" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
